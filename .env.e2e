# .env.e2e — dedicated environment for the Playwright browser E2E suite.
#
# Served by the `php-e2e` container. A real HTTP environment (NOT APP_ENV=test,
# which switches Symfony into BrowserKit/mock-session mode). Shares the
# `database-test` Postgres service with PHPUnit; the E2E fixtures only ever touch
# `@e2e.test` rows, so the suites don't collide as long as they run one after the
# other (see AGENTS.md).
#
# No real secret lives here: APP_SECRET is a throwaway for a local-only test env,
# and the DB credentials are the same non-secret values already tracked in
# .env.test.

APP_ENV=e2e
APP_DEBUG=0
APP_SECRET=e2e_local_only_not_a_secret

DOCKER_POSTGRES_USER_TEST=app_test
DOCKER_POSTGRES_PASSWORD_TEST=!ChangeMe!
DOCKER_POSTGRES_DB_TEST=app_test
DOCKER_POSTGRES_ADDRESS_TEST=database-test
DOCKER_POSTGRES_PORT_TEST=5432

DATABASE_URL="postgresql://${DOCKER_POSTGRES_USER_TEST}:${DOCKER_POSTGRES_PASSWORD_TEST}@${DOCKER_POSTGRES_ADDRESS_TEST}:${DOCKER_POSTGRES_PORT_TEST}/${DOCKER_POSTGRES_DB_TEST}?serverVersion=18&charset=utf8"

DEFAULT_URI=http://php-e2e/
