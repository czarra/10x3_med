# .env.prod — non-secret production defaults (tracked).
#
# Symfony-convention placeholder for future non-secret prod config (mailer DSN
# scheme, trusted proxies, etc.). It is NOT what puts the app into prod: `.env`
# sets APP_ENV=dev and wins env selection, so `.env.prod` only loads once
# APP_ENV is already `prod` from a real environment variable. On Railway that
# comes solely from the `APP_ENV=prod` service variable (runbook step 4) — it is
# load-bearing, not optional.
#
# Never put APP_SECRET / DATABASE_URL here (CLAUDE.md: no secrets in tracked
# .env* files) — those are Railway variables.

APP_ENV=prod
