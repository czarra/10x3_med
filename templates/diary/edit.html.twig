{% extends 'base.html.twig' %}

{% block title %}Edytuj wpis{% endblock %}

{% block body %}
    <h1>Edytuj wpis w dzienniczku</h1>

    {% for message in app.flashes('success') %}
        <p>{{ message }}</p>
    {% endfor %}

    {{ form_start(form) }}
        {{ form_widget(form) }}
        <button type="submit">Zapisz zmiany</button>
    {{ form_end(form) }}

    <p><a href="{{ path('diary_entry_history') }}">Wróć do historii</a></p>
{% endblock %}
